# Lunch Money access token — https://my.lunchmoney.app/developers
LUNCH_MONEY_TOKEN=

# Anthropic API key — only needed for the LLM fallback tier.
# Omit it and lmbot still runs rules + memory (both free/offline).
ANTHROPIC_API_KEY=

# Optional: override the model. Default is claude-opus-5.
# For large bulk runs where cost matters more than accuracy:
#   ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_MODEL=claude-opus-5
